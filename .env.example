# =============================================================================
# Cosmonaut API — Environment Variables
# =============================================================================
# Copy this file to .envrc and fill in the values for your environment.
# All secrets should reference SSM Parameter Store paths, not raw values.

# --- Environment ---
ENV=local
MOCK_AUTH=true
DEV_ALLOWED_EMAILS='["you@example.com"]'

# --- AWS / DynamoDB ---
DYNAMODB_TABLE_NAME=cosmonaut-dev
FAST_WORKER_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/ACCOUNT_ID/cosmonaut-dev-fast
SLOW_WORKER_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/ACCOUNT_ID/cosmonaut-dev-slow

# --- Cognito ---
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_client_id

# --- GCP / Vertex AI ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
# Imagen is not served on the 'global' endpoint; use a regional endpoint.
GCP_IMAGE_LOCATION=us-central1

# --- Static Content (S3 + CDN) ---
STATIC_CONTENT_S3_BUCKET=cosmonaut-ai-dev-images
STATIC_CONTENT_CDN_DOMAIN=your-cloudfront-domain.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=XXXXXXXXXXXXXX

# --- Pinecone ---
PINECONE_INDEX=cosmonaut-dev

# --- SSM Parameter Store paths (secrets fetched at runtime) ---
CLOUDFRONT_PRIVATE_KEY_PARAM=/dev/cosmonaut/cloudfront_private_key
GOOGLE_CLIENT_SECRET_PARAM=/dev/cosmonaut/google_client_secret
PINECONE_API_KEY_PARAM=/dev/cosmonaut/pinecone_api_key
STRIPE_API_KEY_PARAM=/dev/cosmonaut/stripe_api_key
STRIPE_WEBHOOK_SECRET_PARAM=/dev/cosmonaut/stripe_webhook_secret
ELEVENLABS_API_KEY_PARAM=/dev/cosmonaut/elevenlabs_api_key

# --- Stripe ---
STRIPE_PRICE_EXPLORER=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_COSMONAUT=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PORTAL_CONFIG_ID=bpc_XXXXXXXXXXXXXXXXXXXXXXXX

# --- PostHog (write-only project token, not a secret) ---
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
